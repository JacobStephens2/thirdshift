#!/usr/bin/env python3
"""Run conservative affected checks for changes since a base's merge-base."""
import argparse
import os
from pathlib import Path
import re
import subprocess
import tempfile
import time


def git(*arguments):
    return subprocess.check_output(["git", *arguments])


def print_failures(log_path):
    panic = False
    with open(log_path, encoding="utf-8", errors="replace") as log:
        for line in log:
            line = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", line).rstrip()
            if "panicked at" in line:
                print(line, flush=True)
                panic = True
            elif panic:
                if not line or line.lstrip().startswith(("note:", "stack backtrace:", "---")):
                    panic = False
                else:
                    print(line, flush=True)
            elif re.match(
                r"test .+ \.\.\. FAILED$|(?:FAIL|TIMEOUT|SIG[A-Z0-9]+)\s"
                r"|(?:FAIL|ERROR):|error(?:\[|:)"
                r"|not ok \d+ - |✖ (?!failing tests:)", line.strip(),
            ):
                print(line.strip(), flush=True)


def run(*command):
    directory = Path(".affected-tests").resolve()
    directory.mkdir(exist_ok=True)
    name = re.sub(r"[^A-Za-z0-9_-]", "-", "-".join(command))[:120]
    with tempfile.NamedTemporaryFile(dir=directory, prefix=name + "-", suffix=".log",
                                     delete=False) as log:
        print(f"+ {' '.join(command)} (log: {log.name})", flush=True)
        started = time.monotonic()
        try:
            result = subprocess.run(command, stdout=log, stderr=subprocess.STDOUT)
        except OSError as error:
            log.write(f"error: {error}\n".encode())
            result = subprocess.CompletedProcess(command, 1)
    elapsed = time.monotonic() - started
    status = "PASS" if result.returncode == 0 else "FAIL"
    print(f"{status} {' '.join(command)} ({elapsed:.2f}s; log: {log.name})", flush=True)
    if result.returncode:
        print_failures(log.name)
    result.check_returncode()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("base", help="base ref, e.g. main")
    args = parser.parse_args()
    os.chdir(os.fsdecode(git("rev-parse", "--show-toplevel").rstrip(b"\n")))
    base = git("merge-base", args.base, "HEAD").decode().strip()
    paths = set(git("diff", "--name-only", "--no-renames", "-z", base, "--").split(b"\0"))
    paths.update(git("ls-files", "--others", "--exclude-standard", "-z").split(b"\0"))
    paths.discard(b"")
    if not paths:
        print("No changed files; no affected tests.")
        return
    areas = set()
    for path in sorted(paths):
        if path.startswith(b"site/") or path == b"docs/guide.md":
            areas.add("site")
        elif path.startswith(b"scripts/release") or path in {
            b"scripts/generate-release.py", b"scripts/test_generate_release.py",
        }:
            areas.add("release")
        else:
            areas.add("full")
            print(f"Conservative full-suite selection for {os.fsdecode(path)!r}.", flush=True)
    full = "full" in areas or len(areas) > 1
    if "site" in areas:
        run("npm", "test", "--prefix", "site")
        if not full:
            run("cargo", "test", "--test", "share_card", "--test", "site_deploy")
            run("cargo", "test", "--bin", "thirdshift", "prompts_page")
    if full:
        if subprocess.run(["cargo", "nextest", "--version"], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0:
            print("Full Rust suite: using cargo nextest run.", flush=True)
            run("cargo", "nextest", "run")
        else:
            print("Full Rust suite: nextest unavailable; falling back to cargo test.", flush=True)
            run("cargo", "test")
    if "release" in areas:
        if not full:
            run("cargo", "test", "--test", "release")
        run("python3", "-m", "unittest", "discover", "-s", "scripts", "-p", "test_generate_release.py")


if __name__ == "__main__":
    try:
        main()
    except (subprocess.CalledProcessError, OSError) as error:
        raise SystemExit(str(error))
