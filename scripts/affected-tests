#!/usr/bin/env python3
"""Run conservative affected checks for changes since a base's merge-base."""
import argparse
import os
from pathlib import Path
import re
import subprocess
import tempfile
import textwrap
import time


# Markdown read by builds or tests must retain its consumers' checks.
# scripts/test_affected_tests.py guards this list against new code references.
DOC_CHECKS = {
    b"docs/guide.md": "site",
    b"GLOSSARY.md": "site",
    b"docs/experiment-results.md": "full",
    b"docs/adr/0026-each-console-serves-an-api-that-can-do-what-the-cli-can.md": "full",
    b"docs/research/go-vs-rust-prototype.md": "full",
}


# Lines of a failing browser test's error message printed in the summary.
ERROR_LINES = 15


def git(*arguments):
    return subprocess.check_output(["git", *arguments])


def print_error_block(lines):
    while lines and not lines[-1]:
        lines.pop()
    for line in textwrap.dedent("\n".join(lines)).splitlines()[:ERROR_LINES]:
        print(line, flush=True)
    if len(lines) > ERROR_LINES:
        print(f"({len(lines) - ERROR_LINES} more lines left out; see the log)", flush=True)


def print_failures(log_path):
    panic = False
    # A browser test's error block: its header's indentation, whether it is
    # the spec reporter's (which ends at the first stack frame), and its lines.
    block = None
    with open(log_path, encoding="utf-8", errors="replace") as log:
        for line in log:
            line = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", line).rstrip()
            indent = len(line) - len(line.lstrip())
            if block:
                header_indent, spec, lines = block
                if not line or (indent > header_indent
                                and not (spec and line.lstrip().startswith("at "))):
                    lines.append(line)
                    continue
                print_error_block(lines)
                block = None
            if "panicked at" in line:
                print(line, flush=True)
                panic = True
            elif panic:
                if not line or line.lstrip().startswith(("note:", "stack backtrace:", "---")):
                    panic = False
                else:
                    print(line, flush=True)
            elif re.fullmatch(r"error: [|>][-+]?", line.strip()):
                block = (indent, False, [])
            elif re.match(
                r"test .+ \.\.\. FAILED$|(?:FAIL|TIMEOUT|SIG[A-Z0-9]+)\s"
                r"|(?:FAIL|ERROR):|error(?:\[|:)"
                r"|not ok \d+ - |✖ (?!failing tests:)", line.strip(),
            ):
                print(line.strip(), flush=True)
                if line.strip().startswith("✖ "):
                    block = (indent, True, [])
    if block:
        print_error_block(block[2])


def run(*command, cwd=None):
    directory = Path(".affected-tests").resolve()
    directory.mkdir(exist_ok=True)
    name = re.sub(r"[^A-Za-z0-9_-]", "-", "-".join(command))[:120]
    with tempfile.NamedTemporaryFile(dir=directory, prefix=name + "-", suffix=".log",
                                     delete=False) as log:
        print(f"+ {' '.join(command)} (log: {log.name})", flush=True)
        started = time.monotonic()
        try:
            result = subprocess.run(command, cwd=cwd, stdout=log, stderr=subprocess.STDOUT)
        except OSError as error:
            log.write(f"error: {error}\n".encode())
            result = subprocess.CompletedProcess(command, 1)
    elapsed = time.monotonic() - started
    status = "PASS" if result.returncode == 0 else "FAIL"
    print(f"{status} {' '.join(command)} ({elapsed:.2f}s; log: {log.name})", flush=True)
    if result.returncode:
        print_failures(log.name)
    result.check_returncode()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("base", help="base ref, e.g. main")
    args = parser.parse_args()
    os.chdir(os.fsdecode(git("rev-parse", "--show-toplevel").rstrip(b"\n")))
    base = git("merge-base", args.base, "HEAD").decode().strip()
    paths = set(git("diff", "--name-only", "--no-renames", "-z", base, "--").split(b"\0"))
    paths.update(git("ls-files", "--others", "--exclude-standard", "-z").split(b"\0"))
    paths.discard(b"")
    if not paths:
        print("No changed files; no affected tests.")
        return
    areas = set()
    typescript = False
    for path in sorted(paths):
        if path.startswith(b"prototype/go/"):
            areas.add("go")
        elif path.startswith(b"prototypes/typescript/"):
            typescript = True
        elif path.startswith((b"src/console/", b"src/config/console/")) or path in {
            b"src/console.rs", b"src/config/console.rs", b"tests/console/scoring_fixture.py",
            b"tests/fixtures/waterfall-logs.jsonl", b"tests/fixtures/waterfall-spans.jsonl",
        }:
            areas.update({"console", "full"})
            print(f"Console browser tests and full Rust suite for {os.fsdecode(path)!r}.", flush=True)
        elif path.startswith(b"console/"):
            areas.add("console")
            print(f"Console browser tests for {os.fsdecode(path)!r}.", flush=True)
        elif path in DOC_CHECKS:
            areas.add(DOC_CHECKS[path])
        elif (path.startswith(b"docs/") and path.endswith(b".md")) or path in {
            b"GLOSSARY.md", b"CODING_STANDARDS.md",
        }:
            print(f"No checks for docs-only {os.fsdecode(path)!r}.", flush=True)
        elif path.startswith(b"site/"):
            areas.add("site")
        elif path.startswith(b"scripts/release") or path in {
            b"scripts/generate-release.py", b"scripts/test_generate_release.py",
        }:
            areas.add("release")
        else:
            areas.add("full")
            print(f"Conservative full-suite selection for {os.fsdecode(path)!r}.", flush=True)
    rust_areas = areas - {"go"}
    full = "full" in rust_areas or len(rust_areas) > 1
    if "go" in areas:
        run("go", "test", "./...", cwd="prototype/go")
    if typescript:
        run("bun", "run", "--cwd", "prototypes/typescript", "typecheck")
        run("bun", "test", "--cwd", "prototypes/typescript")
    if "site" in areas:
        run("npm", "test", "--prefix", "site")
        if not full:
            run("cargo", "test", "--test", "share_card", "--test", "site_deploy")
            run("cargo", "test", "--bin", "thirdshift", "prompts_page")
    if "console" in areas:
        run("cargo", "build", "--locked")
        run("npm", "test", "--prefix", "console")
    if full:
        if subprocess.run(["cargo", "nextest", "--version"], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0:
            print("Full Rust suite: using cargo nextest run.", flush=True)
            run("cargo", "nextest", "run")
        else:
            print("Full Rust suite: nextest unavailable; falling back to cargo test.", flush=True)
            run("cargo", "test")
    if "release" in areas:
        if not full:
            run("cargo", "test", "--test", "release")
        run("python3", "-m", "unittest", "discover", "-s", "scripts", "-p", "test_generate_release.py")


if __name__ == "__main__":
    try:
        main()
    except (subprocess.CalledProcessError, OSError) as error:
        raise SystemExit(str(error))
