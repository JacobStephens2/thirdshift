#!/usr/bin/env python3
"""Fake `claude` for the thirdshift test harness.

Each call appends a record to the JSON list in $FAKE_CLAUDE_RECORD: its argv,
prompt, working directory, the branch checked out there, whether a merge is in
progress there, and a snapshot of the
--plugin-dir contents (the directory is gone by the time a test looks).

It then runs a per-test bash script in the working directory, emits a couple
of stream-json lines, and exits with the script's exit code. A session's issue
is the first Issue URL in its prompt, and its count the number of sessions so
far whose prompt names that issue, this one included. The script is the first
of these files that exists:

    $FAKE_CLAUDE_SCRIPT.issue-<issue>.<count>
    $FAKE_CLAUDE_SCRIPT.issue-<issue>
    $FAKE_CLAUDE_SCRIPT.<n>     for the n-th call overall (1-based)
    $FAKE_CLAUDE_SCRIPT

Parallel child Runs start sessions at once, so recording a call holds an
exclusive lock on $FAKE_CLAUDE_RECORD.lock, and the script is chosen under it.

The `init` line carries session id `fake-session-<n>` for the n-th call. Lines
the script appends to the file named by $FAKE_CLAUDE_AFTER_RESULT are emitted
after the closing `result` line, e.g. to kill a background task as the session
ends.

Called without --output-format, as `claude -p` with its prompt on stdin, it
records stdin as `stdin` and prints only what the script prints, as print
mode's plain text output does.
"""

import fcntl
import json
import os
import re
import subprocess
import sys


def plugin_snapshot(plugin_dir):
    files = {}
    for dirpath, _, filenames in os.walk(plugin_dir):
        for filename in filenames:
            path = os.path.join(dirpath, filename)
            with open(path, encoding="utf-8", errors="replace") as f:
                files[os.path.relpath(path, plugin_dir)] = f.read()
    return files


ISSUE_URL = re.compile(r"https://github\.com/[^/\s]+/[^/\s]+/issues/(\d+)")


def issue_of(prompt):
    """The number of the first Issue URL in `prompt`, if any."""
    match = ISSUE_URL.search(prompt or "")
    return match.group(1) if match else None


def script_for(records):
    """The script for the session just recorded last in `records`."""
    script = os.environ["FAKE_CLAUDE_SCRIPT"]
    issue = issue_of(records[-1]["prompt"])
    candidates = []
    if issue is not None:
        count = sum(1 for record in records if issue_of(record["prompt"]) == issue)
        candidates += [f"{script}.issue-{issue}.{count}", f"{script}.issue-{issue}"]
    candidates.append(f"{script}.{len(records)}")
    return next((path for path in candidates if os.path.exists(path)), script)


def main():
    argv = sys.argv[1:]
    plugin_dir = argv[argv.index("--plugin-dir") + 1] if "--plugin-dir" in argv else None
    branch = subprocess.run(
        ["git", "branch", "--show-current"], capture_output=True, text=True
    ).stdout.strip()
    merging = (
        subprocess.run(
            ["git", "rev-parse", "-q", "--verify", "MERGE_HEAD"], capture_output=True
        ).returncode
        == 0
    )

    text_mode = "--output-format" not in argv
    record_path = os.environ["FAKE_CLAUDE_RECORD"]
    lock = open(record_path + ".lock", "w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    records = []
    if os.path.exists(record_path):
        with open(record_path) as f:
            records = json.load(f)
    records.append(
        {
            "argv": argv,
            "prompt": argv[-1] if argv else None,
            "cwd": os.getcwd(),
            "branch": branch,
            "merging": merging,
            "plugin_dir": plugin_dir,
            "plugin_files": plugin_snapshot(plugin_dir) if plugin_dir else {},
            "stdin": sys.stdin.read() if text_mode else None,
        }
    )
    with open(record_path, "w") as f:
        json.dump(records, f, indent=2)
    script = script_for(records)
    lock.close()

    script = script_for(records)
    if text_mode:
        sys.exit(subprocess.run(["bash", "-e", script]).returncode)

    init = {
        "type": "system",
        "subtype": "init",
        "cwd": os.getcwd(),
        "session_id": f"fake-session-{len(records)}",
    }
    print(json.dumps(init), flush=True)
    # Beside the record, not in $TMPDIR, which tests expect to be left empty.
    after_result = f"{record_path}.after-result.{len(records)}"
    env = dict(os.environ, FAKE_CLAUDE_AFTER_RESULT=after_result)
    code = subprocess.run(["bash", "-e", script], env=env).returncode
    print(json.dumps({"type": "result", "subtype": "success", "is_error": code != 0}), flush=True)
    if os.path.exists(after_result):
        with open(after_result) as f:
            print(f.read(), end="", flush=True)
    sys.exit(code)


main()
