#!/usr/bin/env python3
"""Fake `gh` for the thirdshift test harness.

State lives in the JSON file named by $FAKE_GH_STATE:

    {"repo": "owner/repo",
     "issues": {"<number>": "OPEN" | "CLOSED"},
     "titles"?: {"<number>": "<title>"},
     "comments"?: {"<number>": ["<body>", ...]},
     "prs": [{"number", "url", "head", "base", "state", "isDraft", "title", "body",
              "mergeable"?, "unknown_polls"?}],
     "checks": {"<sha>": [{"name", "conclusion", "url", "pending_polls"?}]},
     "statuses": {"<sha>": [{"context", "state", "url"}]},
     "on_ci_read"?: {"times", "script", "seen"},
     "on_merge"?: {"times", "script"},
     "refuse_merges"?: {"times", "error"},
     "after_merge"?: "<script>",
     "failing"?: ["<command> <subcommand>", ...],
     "user_email"?: "<address>" | null,
     "sub_issues"?: {"<number>": [<number>, ...]},
     "labels"?: {"<number>": ["<label>", ...]},
     "blocked_by"?: {"<number>": [<number>, ...]}}

`gh pr merge` makes a real merge commit of the PR's head into its base in the
bare origin repo beside $FAKE_GH_STATE (`origin.git`), whose HEAD names the
default branch. It closes the issues the PR body closes (`Closes #<n>` and the
like) only when the base is the default branch, as GitHub does.

A PR's `headRefOid` is its head branch's tip on origin, frozen when it is
merged, and a merged PR records its merge commit as `mergeCommit`. Its
`closingIssuesReferences` are the issues its body closes.
`gh repo view` reports origin's HEAD as the default branch.

An issue's title is its entry in `titles`, else `Issue <number>`.

`gh api user` answers with the signed-in user's profile, whose public `email`
is `user_email`, else null. `gh fake fails 'api user'` makes it fail.

`gh api repos/<repo>/releases/generate-notes` answers with GitHub's
generated notes: a line for each merged PR whose merge commit is reachable from
`target_commitish` and not from `previous_tag_name`. `<repo>` may be gh's
`{owner}/{repo}` placeholder, here and in the commit endpoints.
`gh api repos/<repo>/actions/runs?head_sha=<sha>` answers with the workflow
runs on <sha>: its check runs, read as the check-runs endpoint reads them.

`gh api graphql` answers the one query thirdshift reads a Spec's Tickets
with: the sub-issues of issue `$number` (its `sub_issues`, in order), each
with its state, its `labels`, how many sub-issues it has of its own, and the
issues it is `blocked_by` with their states. Any other query exits 2.

`gh issue close` closes the issue, recording its `--comment`; on an issue
already closed it only warns, as gh does.

A PR's mergeable state reports as UNKNOWN for its first `unknown_polls` reads.
A check run reports as in progress for its first `pending_polls` reads, then as
completed with its `conclusion`.

Tests and fake agents change that state with `gh fake …` (not a real gh
command):

    gh fake checks <sha> '<JSON list>'      set the check runs on <sha>
    gh fake statuses <sha> '<JSON list>'    set the commit statuses on <sha>
    gh fake pr <head> <field> '<JSON>'      set a field of <head>'s newest PR
    gh fake issue <number> <state>          set issue <number> OPEN or CLOSED
    gh fake on-ci-read <times> '<script>'   run <script> in bash the first time
                                            thirdshift reads CI on each new sha,
                                            for the next <times> shas, with the
                                            sha in $FAKE_CI_SHA
    gh fake on-merge <times> '<script>'     run <script> in bash before each of
                                            the next <times> `gh pr merge` calls
    gh fake refuse-merges <times> '<error>' fail the next <times> `gh pr merge`
                                            calls with <error> on stderr, after
                                            any on-merge script
    gh fake after-merge '<script>'          run <script> in bash after each
                                            successful `gh pr merge`
    gh fake fails '<command> <subcommand>'  make every such call fail, e.g.
                                            'issue close'
    gh fake user-email '<JSON>'             set the public profile email, an
                                            address or null
    gh fake labels <number> '<JSON list>'   set issue <number>'s labels

Every call's argv is appended to the JSON list in $FAKE_GH_RECORD.

Only the subcommands thirdshift and the fake agents use are supported. Anything
else exits 2 so an unexpected call fails loudly.
"""

import json
import os
import re
import subprocess
import sys
import tempfile


def load():
    with open(os.environ["FAKE_GH_STATE"]) as f:
        return json.load(f)


def save(state):
    with open(os.environ["FAKE_GH_STATE"], "w") as f:
        json.dump(state, f, indent=2)


BOOLEAN_FLAGS = {"draft", "undo", "paginate", "merge"}


def parse(args):
    """Split args into positionals and a dict of --flag values."""
    positional, flags = [], {}
    i = 0
    while i < len(args):
        arg = args[i]
        if arg.startswith("-"):
            name = arg.lstrip("-")
            if name in BOOLEAN_FLAGS:
                value = True
            elif "=" in name:
                name, value = name.split("=", 1)
            else:
                i += 1
                value = args[i]
            flags[name] = value
        else:
            positional.append(arg)
        i += 1
    return positional, flags


def check_repo(state, flags):
    """`{owner}/{repo}` is gh's placeholder for the current directory's repo,
    which is always the fake's."""
    repo = flags.get("R") or flags.get("repo")
    if repo is not None and repo != "{owner}/{repo}" and repo.lower() != state["repo"].lower():
        die(f"fake gh: unknown repo {repo}")


def die(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


def pr_create(state, flags):
    number = len(state["prs"]) + 1
    pr = {
        "number": number,
        "url": f"https://github.com/{state['repo']}/pull/{number}",
        "head": flags["head"],
        "base": flags["base"],
        "state": "OPEN",
        "isDraft": "draft" in flags,
        "title": flags.get("title", ""),
        "body": flags.get("body", ""),
    }
    state["prs"].append(pr)
    save(state)
    print(pr["url"])


def pr_view(state, positional, flags):
    """By head branch, its newest PR, or by number. `--jq .<field>` prints
    that one field raw, as gh does for a string."""
    head = positional[0]
    if head.isdigit():
        matches = [pr for pr in state["prs"] if pr["number"] == int(head)]
    else:
        matches = [pr for pr in state["prs"] if pr["head"] == head]
    if not matches:
        die(f'no pull requests found for branch "{head}"')
    pr = matches[-1]
    wanted = flags["json"].split(",")
    jq = flags.get("jq")
    if jq is not None:
        if not jq.startswith(".") or jq[1:] not in wanted:
            die(f"fake gh: unsupported --jq {jq}", 2)
        fields = dict(pr_fields(pr, wanted), title=pr["title"], body=pr.get("body", ""))
        print(fields[jq[1:]])
        return
    fields = pr_fields(pr, wanted)
    fields["closingIssuesReferences"] = [
        {"number": int(number)} for number in CLOSING_KEYWORD.findall(pr.get("body", ""))
    ]
    if "mergeable" in wanted and pr.get("unknown_polls", 0) > 0:
        pr["unknown_polls"] -= 1
        save(state)
        fields["mergeable"] = "UNKNOWN"
    print(json.dumps({key: fields[key] for key in wanted}))


def record(args):
    path = os.environ["FAKE_GH_RECORD"]
    calls = []
    if os.path.exists(path):
        with open(path) as f:
            calls = json.load(f)
    calls.append(args)
    with open(path, "w") as f:
        json.dump(calls, f, indent=2)


def pr_fields(pr, wanted=()):
    """The PR's JSON fields. `headRefOid`, its head as merged or else its head
    branch's tip on origin, is read only when `wanted`."""
    fields = {
        "url": pr["url"],
        "state": pr["state"],
        "headRefName": pr["head"],
        "baseRefName": pr["base"],
        "isDraft": pr["isDraft"],
        "number": pr["number"],
        "isCrossRepository": pr.get("isCrossRepository", False),
        "mergeable": pr.get("mergeable", "MERGEABLE"),
        "mergeCommit": {"oid": pr["mergeCommit"]} if "mergeCommit" in pr else None,
    }
    if "headRefOid" in wanted:
        fields["headRefOid"] = pr.get("headRefOid") or origin("rev-parse", f"refs/heads/{pr['head']}")
    return fields


def pr_list(state, flags):
    """Newest first. `--search head:<prefix>` matches head branches starting
    with <prefix>, as GitHub's search does; `--head <branch>` matches that
    branch exactly. `--jq` is supported only as `PR_LINE_OF_NEWEST`."""
    wanted_state = flags.get("state", "open").upper()
    search = flags.get("search", "")
    prefix = search[len("head:"):] if search.startswith("head:") else ""
    if search and not prefix:
        die(f"fake gh: unsupported search {search}", 2)
    prs = [
        pr
        for pr in reversed(state["prs"])
        if pr["head"].startswith(prefix)
        and flags.get("head", pr["head"]) == pr["head"]
        and (wanted_state == "ALL" or pr["state"] == wanted_state)
    ][: int(flags.get("limit", 30))]
    wanted = flags["json"].split(",")
    listed = [{key: pr_fields(pr, wanted)[key] for key in wanted} for pr in prs]
    if "jq" not in flags:
        print(json.dumps(listed))
    elif flags["jq"] == PR_LINE_OF_NEWEST:
        for pr in listed[:1]:
            merge = (pr["mergeCommit"] or {}).get("oid", "")
            print(f"{pr['state']} {pr['url']} {pr['headRefOid']} {merge}".rstrip())
    else:
        die(f"fake gh: unsupported --jq {flags['jq']}", 2)


def pr_ready(state, positional, flags):
    head = positional[0]
    matches = [pr for pr in state["prs"] if pr["head"] == head]
    if not matches:
        die(f'no pull requests found for branch "{head}"')
    pr = matches[-1]
    if pr["state"] != "OPEN":
        die(f"pull request #{pr['number']} is not open")
    pr["isDraft"] = "undo" in flags
    save(state)


def scenario_root():
    return os.path.dirname(os.environ["FAKE_GH_STATE"])


def origin_repo():
    return os.path.join(scenario_root(), "origin.git")


def git(repo, *args):
    """Run git in `repo`, returning the completed process."""
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)


def origin(*args):
    """Run git in the bare origin repo and return its stdout."""
    result = git(origin_repo(), *args)
    result.check_returncode()
    return result.stdout.strip()


CLOSING_KEYWORD = re.compile(r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?) #(\d+)", re.I)


def pr_merge(state, positional, flags):
    """Only a merge commit on a matching head is supported: anything else,
    such as --auto or --delete-branch, is an unexpected call."""
    unsupported = set(flags) - {"merge", "match-head-commit", "repo", "R"}
    if "merge" not in flags or "match-head-commit" not in flags or unsupported:
        die(f"fake gh: unsupported pr merge flags {sorted(flags)}", 2)
    state = run_hook(state, "on_merge")
    refusal = state.get("refuse_merges")
    if refusal and refusal["times"] > 0:
        refusal["times"] -= 1
        save(state)
        die(refusal["error"])
    head = positional[0]
    matches = [pr for pr in state["prs"] if pr["head"] == head]
    if not matches:
        die(f'no pull requests found for branch "{head}"')
    pr = matches[-1]
    if pr["state"] != "OPEN":
        die(f"pull request #{pr['number']} is not open")
    head_sha = origin("rev-parse", f"refs/heads/{pr['head']}")
    if head_sha != flags["match-head-commit"]:
        die("GraphQL: Head branch was modified. Review and try the merge again. (mergePullRequest)")
    with tempfile.TemporaryDirectory(dir=scenario_root()) as work:
        git(work, "clone", "-q", "-b", pr["base"], origin_repo(), ".")
        message = f"Merge pull request #{pr['number']} from {state['repo'].split('/')[0]}/{head}"
        if git(work, "merge", "-q", "--no-ff", "-m", message, head_sha).returncode != 0:
            die("Pull request is not mergeable: the merge commit cannot be cleanly created.")
        pushed = git(work, "push", "-q", "origin", f"HEAD:{pr['base']}")
        if pushed.returncode != 0:
            die(f"fake gh: pushing the merge failed: {pushed.stderr}")
    pr["state"] = "MERGED"
    pr["headRefOid"] = head_sha
    pr["mergeCommit"] = origin("rev-parse", f"refs/heads/{pr['base']}")
    default = origin("symbolic-ref", "--short", "HEAD")
    if pr["base"] == default:
        for number in CLOSING_KEYWORD.findall(pr.get("body", "")):
            if number in state["issues"]:
                state["issues"][number] = "CLOSED"
    save(state)
    if "after_merge" in state:
        subprocess.run(["bash", "-euc", state["after_merge"]], check=True, stdout=sys.stderr)


def issue_view(state, positional, flags):
    number = positional[0]
    if number not in state["issues"]:
        die(f"GraphQL: Could not resolve to an issue or pull request with the number of {number}.")
    fields = {
        "number": int(number),
        "state": state["issues"][number],
        "title": state.get("titles", {}).get(number, f"Issue {number}"),
    }
    wanted = flags["json"].split(",")
    print(json.dumps({key: fields[key] for key in wanted}))


def repo_view(state, positional, flags):
    if positional and positional[0].lower() != state["repo"].lower():
        die(f"fake gh: unknown repo {positional[0]}")
    fields = {"defaultBranchRef": {"name": origin("symbolic-ref", "--short", "HEAD")}}
    wanted = flags["json"].split(",")
    print(json.dumps({key: fields[key] for key in wanted}))


def issue_close(state, positional, flags):
    number = positional[0]
    if number not in state["issues"]:
        die(f"GraphQL: Could not resolve to an issue or pull request with the number of {number}.")
    if state["issues"][number] == "CLOSED":
        print(f"! Issue #{number} is already closed", file=sys.stderr)
        return
    if "comment" in flags:
        state.setdefault("comments", {}).setdefault(number, []).append(flags["comment"])
    state["issues"][number] = "CLOSED"
    save(state)


def api(state, positional, flags):
    """The signed-in user, the two commit endpoints thirdshift reads CI from,
    or the workflow runs on a commit that the release script waits for. Each
    answers one page, each item of the list `--jq '.<list>[]'` names on its
    own line, or for the workflow runs one `<status> <conclusion> <name>` line
    per run with `--jq` set to `WORKFLOW_RUN_LINES`."""
    if positional[0] == "user" and not flags:
        print(json.dumps({"login": "runner", "email": state.get("user_email")}))
        return
    match = re.fullmatch(
        r"repos/([^/]+/[^/]+)/(?:commits/([0-9a-f]+)/(check-runs|status)|actions/(runs)\?head_sha=([0-9a-f]+))(&.*|\?.*)?",
        positional[0],
    )
    if not match:
        die(f"fake gh: unsupported api path {positional[0]}", 2)
    repo, sha, endpoint, runs_endpoint, runs_sha, _ = match.groups()
    check_repo(state, {"repo": repo})
    if runs_endpoint:
        if flags.get("jq") != WORKFLOW_RUN_LINES:
            die(f"fake gh: unsupported --jq {flags.get('jq')}", 2)
        for run in read_checks(state, runs_sha):
            print(f"{run['status']} {run['conclusion'] or 'null'} {run['name']}")
        return
    if endpoint == "check-runs":
        items, field = read_checks(state, sha), "check_runs"
    else:
        items = [
            {"context": s["context"], "state": s["state"], "target_url": s.get("url")}
            for s in state.get("statuses", {}).get(sha, [])
        ]
        field = "statuses"
    if flags.get("jq") != f".{field}[]":
        die(f"fake gh: unsupported --jq {flags.get('jq')}", 2)
    for item in items:
        print(json.dumps(item))


def read_checks(state, sha):
    """The check runs on `sha`, each read once, after any `on-ci-read`
    script."""
    state = run_ci_read_hook(state, sha)
    runs = []
    for check in state.get("checks", {}).get(sha, []):
        pending = check.get("pending_polls", 0) > 0
        if pending:
            check["pending_polls"] -= 1
        runs.append(
            {
                "name": check["name"],
                "status": "in_progress" if pending else "completed",
                "conclusion": None if pending else check["conclusion"],
                "details_url": check.get("url"),
            }
        )
    save(state)
    return runs


GENERATE_NOTES = re.compile(r"repos/([^/]+/[^/]+)/releases/generate-notes")

PR_LINE_OF_NEWEST = '.[0] // empty | "\\(.state) \\(.url) \\(.headRefOid) \\(.mergeCommit.oid // "")"'

WORKFLOW_RUN_LINES = '.workflow_runs[] | "\\(.status) \\(.conclusion) \\(.name)"'


def api_fields(args):
    """The `-f`/`-F` fields of a `gh api` call, by name."""
    fields = {}
    for flag, pair in zip(args, args[1:]):
        if flag in ("-f", "-F", "--raw-field", "--field"):
            name, value = pair.split("=", 1)
            fields[name] = value
    return fields


def generate_notes(state, args):
    """GitHub's generated release notes for `tag_name` at `target_commitish`:
    one line per merged PR whose merge commit is reachable from the target but
    not from `previous_tag_name`, oldest first, then the compare link. Only
    `--jq .body` is supported."""
    fields = api_fields(args)
    jq = next((value for flag, value in zip(args, args[1:]) if flag == "--jq"), None)
    if jq != ".body":
        die(f"fake gh: unsupported --jq {jq}", 2)
    check_repo(state, {"repo": GENERATE_NOTES.fullmatch(args[0]).group(1)})
    tag, target = fields["tag_name"], fields["target_commitish"]
    previous = fields.get("previous_tag_name")

    def reachable(commit, ref):
        return git(origin_repo(), "merge-base", "--is-ancestor", commit, ref).returncode == 0

    lines = [
        f"* {pr['title']} by @runner in {pr['url']}"
        for pr in state["prs"]
        if "mergeCommit" in pr
        and reachable(pr["mergeCommit"], target)
        and not (previous and reachable(pr["mergeCommit"], previous))
    ]
    compare = f"{previous}...{tag}" if previous else f"commits/{tag}"
    print("## What's Changed\n" + "\n".join(lines))
    print(f"\n**Full Changelog**: https://github.com/{state['repo']}/compare/{compare}")


def graphql(state, args):
    """The Tickets query: `-f query=...` plus `-f`/`-F` variables."""
    variables = api_fields(args)
    query = variables.pop("query", "")
    if not all(field in query for field in ("subIssues", "blockedBy", "labels", "totalCount")):
        die(f"fake gh: unsupported graphql query {query}", 2)
    check_repo(state, {"repo": f"{variables['owner']}/{variables['repo']}"})
    number = variables["number"]
    if number not in state["issues"]:
        die(f"GraphQL: Could not resolve to an Issue with the number of {number}. (repository.issue)")

    def issue(n):
        return {"number": int(n), "state": state["issues"].get(str(n), "OPEN")}

    nodes = [
        dict(
            issue(ticket),
            labels={"nodes": [{"name": label} for label in state.get("labels", {}).get(str(ticket), [])]},
            subIssues={"totalCount": len(state.get("sub_issues", {}).get(str(ticket), []))},
            blockedBy={"nodes": [issue(b) for b in state.get("blocked_by", {}).get(str(ticket), [])]},
        )
        for ticket in state.get("sub_issues", {}).get(number, [])
    ]
    print(json.dumps({"data": {"repository": {"issue": {"subIssues": {"nodes": nodes}}}}}))


def run_ci_read_hook(state, sha):
    """Run the `on-ci-read` script, if it has runs left and has not yet run for
    `sha`, e.g. to move the Base branch while thirdshift waits for CI. Returns
    the state as the script left it."""
    hook = state.get("on_ci_read")
    if not hook or sha in hook["seen"]:
        return state
    hook["seen"].append(sha)
    return run_hook(state, "on_ci_read", FAKE_CI_SHA=sha)


def run_hook(state, name, **env):
    """Run the script of hook `name`, if it has runs left, with `env` added to
    the environment. Returns the state as the script left it."""
    hook = state.get(name)
    if not hook or hook["times"] == 0:
        return state
    hook["times"] -= 1
    save(state)
    subprocess.run(
        ["bash", "-euc", hook["script"]],
        check=True,
        stdout=sys.stderr,
        env=dict(os.environ, **env),
    )
    return load()


def fake(state, args):
    if args[0] in ("checks", "statuses"):
        state.setdefault(args[0], {})[args[1]] = json.loads(args[2])
    elif args[0] == "on-ci-read":
        state["on_ci_read"] = {"times": int(args[1]), "script": args[2], "seen": []}
    elif args[0] == "on-merge":
        state["on_merge"] = {"times": int(args[1]), "script": args[2]}
    elif args[0] == "refuse-merges":
        state["refuse_merges"] = {"times": int(args[1]), "error": args[2]}
    elif args[0] == "after-merge":
        state["after_merge"] = args[1]
    elif args[0] == "issue":
        state["issues"][args[1]] = args[2]
    elif args[0] == "labels":
        state.setdefault("labels", {})[args[1]] = json.loads(args[2])
    elif args[0] == "user-email":
        state["user_email"] = json.loads(args[1])
    elif args[0] == "fails":
        state.setdefault("failing", []).append(args[1])
    elif args[0] == "pr":
        [pr for pr in state["prs"] if pr["head"] == args[1]][-1][args[2]] = json.loads(args[3])
    else:
        die(f"fake gh: unsupported fake command {args}", 2)
    save(state)


def main():
    args = sys.argv[1:]
    record(args)
    state = load()
    if " ".join(args[:2]) in state.get("failing", []):
        die("HTTP 502: Bad Gateway (https://api.github.com/graphql)")
    if args[:2] == ["pr", "create"]:
        positional, flags = parse(args[2:])
        check_repo(state, flags)
        pr_create(state, flags)
    elif args[:2] == ["pr", "view"]:
        positional, flags = parse(args[2:])
        check_repo(state, flags)
        pr_view(state, positional, flags)
    elif args[:2] == ["pr", "list"]:
        positional, flags = parse(args[2:])
        check_repo(state, flags)
        pr_list(state, flags)
    elif args[:2] == ["pr", "ready"]:
        positional, flags = parse(args[2:])
        check_repo(state, flags)
        pr_ready(state, positional, flags)
    elif args[:2] == ["pr", "merge"]:
        positional, flags = parse(args[2:])
        check_repo(state, flags)
        pr_merge(state, positional, flags)
    elif args[:2] == ["issue", "view"]:
        positional, flags = parse(args[2:])
        check_repo(state, flags)
        issue_view(state, positional, flags)
    elif args[:2] == ["repo", "view"]:
        positional, flags = parse(args[2:])
        repo_view(state, positional, flags)
    elif args[:2] == ["issue", "close"]:
        positional, flags = parse(args[2:])
        check_repo(state, flags)
        issue_close(state, positional, flags)
    elif args[:2] == ["api", "graphql"]:
        graphql(state, args[2:])
    elif args[0] == "api" and GENERATE_NOTES.fullmatch(args[1]):
        generate_notes(state, args[1:])
    elif args[0] == "api":
        positional, flags = parse(args[1:])
        api(state, positional, flags)
    elif args[0] == "fake":
        fake(state, args[1:])
    else:
        die(f"fake gh: unsupported command: {args}", 2)


main()
